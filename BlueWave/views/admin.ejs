<!DOCTYPE html>
<html lang="nl">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BlueWave | Admin Panel</title>

    <link rel="stylesheet" href="/style.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

</head>

<body>

<div class="dashboard">

    <aside class="sidebar">

        <h2>👑 BlueWave</h2>

        <ul>

            <li><a href="/dashboard">🏠 Dashboard</a></li>

            <li><a href="/admin">👑 Admin Panel</a></li>

            <li><a href="/orders">📦 Bestellingen</a></li>

            <li><a href="/users">👥 Gebruikers</a></li>

            <li><a href="/tickets">🎫 Tickets</a></li>

            <li><a href="/news">📰 Nieuws</a></li>

            <li><a href="/settings">⚙️ Instellingen</a></li>

            <li><a href="/logout">🚪 Uitloggen</a></li>

        </ul>

    </aside>

    <main class="main">

        <h1>👑 Admin Panel</h1>

        <p>
            Welkom in het beheerpaneel.
        </p>

        <div class="cards">

            <div class="card">

                <h2>📦</h2>

                <h3>Bestellingen</h3>

                <button>Openen</button>

            </div>

            <div class="card">

                <h2>👥</h2>

                <h3>Gebruikers</h3>

                <button>Openen</button>

            </div>

            <div class="card">

                <h2>🎫</h2>

                <h3>Tickets</h3>

                <button>Openen</button>

            </div>

            <div class="card">

                <h2>📰</h2>

                <h3>Nieuws</h3>

                <button>Openen</button>

            </div>

            <div class="card">

                <h2>📩</h2>

                <h3>Contact</h3>

                <button>Openen</button>

            </div>

            <div class="card">

                <h2>⚙️</h2>

                <h3>Instellingen</h3>

                <button>Openen</button>

            </div>

        </div>

        <h2 style="margin-top:50px;">📋 Recente Activiteit</h2>

        <table>

            <tr>

                <th>Gebruiker</th>
                <th>Actie</th>
                <th>Datum</th>

            </tr>

            <tr>

                <td>Dilan</td>
                <td>Nieuwe bestelling bekeken</td>
                <td>10-07-2026</td>

            </tr>

            <tr>

                <td>Developer</td>
                <td>Nieuws aangepast</td>
                <td>10-07-2026</td>

            </tr>

            <tr>

                <td>Admin</td>
                <td>Gebruiker verwijderd</td>
                <td>10-07-2026</td>

            </tr>

        </table>

    </main>

</div>

</body>

</html>