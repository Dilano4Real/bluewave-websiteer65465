<!DOCTYPE html>
<html lang="nl">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BlueWave | Developer Panel</title>

    <link rel="stylesheet" href="/style.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

</head>

<body>

<div class="dashboard">

    <aside class="sidebar">

        <h2>💻 BlueWave</h2>

        <ul>

            <li><a href="/dashboard">🏠 Dashboard</a></li>
            <li><a href="/admin">👑 Admin Panel</a></li>
            <li><a href="/developer">💻 Developer</a></li>

            <hr>

            <li><a href="/orders">📦 Bestellingen</a></li>
            <li><a href="/users">👥 Gebruikers</a></li>
            <li><a href="/tickets">🎫 Tickets</a></li>

            <hr>

            <li><a href="/bot">🤖 Discord Bot</a></li>
            <li><a href="/database">🗄️ Database</a></li>
            <li><a href="/files">📁 Bestanden</a></li>
            <li><a href="/logs">📝 Logs</a></li>

            <hr>

            <li><a href="/settings">⚙️ Instellingen</a></li>
            <li><a href="/logout">🚪 Uitloggen</a></li>

        </ul>

    </aside>

    <main class="main">

        <h1>💻 Developer Panel</h1>

        <p>
            Welkom in het Developer Panel.
            Alleen Developers en Owners hebben toegang.
        </p>

        <div class="cards">

            <div class="card">
                <h2>🤖</h2>
                <h3>Discord Bot</h3>
                <button>Beheren</button>
            </div>

            <div class="card">
                <h2>🗄️</h2>
                <h3>Database</h3>
                <button>Openen</button>
            </div>

            <div class="card">
                <h2>📁</h2>
                <h3>Bestanden</h3>
                <button>Openen</button>
            </div>

            <div class="card">
                <h2>📝</h2>
                <h3>Logs</h3>
                <button>Bekijken</button>
            </div>

            <div class="card">
                <h2>🚧</h2>
                <h3>Onderhoud</h3>
                <button>Inschakelen</button>
            </div>

            <div class="card">
                <h2>🌐</h2>
                <h3>Website</h3>
                <button>Herstarten</button>
            </div>

        </div>

        <h2 style="margin-top:50px;">⚡ Server Status</h2>

        <table>

            <tr>
                <th>Service</th>
                <th>Status</th>
            </tr>

            <tr>
                <td>Website</td>
                <td style="color:lime;">🟢 Online</td>
            </tr>

            <tr>
                <td>Discord Bot</td>
                <td style="color:lime;">🟢 Online</td>
            </tr>

            <tr>
                <td>Database</td>
                <td style="color:lime;">🟢 Verbonden</td>
            </tr>

            <tr>
                <td>API</td>
                <td style="color:lime;">🟢 Actief</td>
            </tr>

        </table>

    </main>

</div>

</body>

</html>